SMTP_EMAIL=youraccount@gmail.com
SMTP_APP_PASSWORD=your gmail app password
JWT_SECRET=generate-a-random-hex-string-here
FIRST_ADMIN_EMAIL=first.admin@example.com
# MySQL connection (the only database engine)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DB=mis_reports_v2
MYSQL_USER=mis_app
MYSQL_PASSWORD=your-mysql-app-password
# Folder containing mysqldump.exe/mysql.exe, used by the admin backup/restore
# page and backend/scripts/backup_mysql.bat. Leave unset to auto-detect
# D:/mysql/mysql-*-winx64/bin.
MYSQL_BIN_DIR=C:/mysql/mysql-9.7.2-winx64/bin
# Two-step login: after the password, a 6-digit code is emailed and must be
# entered. Set to off to fall back to password-only login (e.g. if SMTP is down).
LOGIN_2FA=on

# Test-suite MySQL user: ALL on `mis\_reports\_test\_%`.* only (see tests/conftest.py).
# The tests fail without these. Create the user as in docs/DB_V2_CUTOVER.md, section "Test database".
MYSQL_TEST_USER=mis_test
MYSQL_TEST_PASSWORD=your-mysql-test-password
