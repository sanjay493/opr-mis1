{
  "permissions": {
    "allow": [
      "Bash(backend/venv/Scripts/python.exe *)",
      "Bash(venv/Scripts/python.exe *)",
      "Bash(./venv/Scripts/python.exe *)",
      "Bash(venv/Scripts/python *)",
      "Bash(python -m py_compile *)",
      "PowerShell(& \"C:\\opr-mis1\\backend\\venv\\Scripts\\python.exe\" *)",
      "Bash(curl * http://localhost:*)",
      "Bash(curl * http://127.0.0.1:*)",
      "Bash(curl * \"http://localhost:*)",
      "Bash(curl * \"http://127.0.0.1:*)",
      "Bash(sqlite3 *mis_reports.db *)",
      "Bash(npm run *)",
      "Bash(npm list *)",
      "Bash(npx playwright *)",
      "Bash(node -c *)",
      "Bash(netstat -ano)",
      "Bash(findstr *)",
      "Bash(git commit -m *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/backend/venv/Scripts/python.exe\" \"$CLAUDE_PROJECT_DIR/backend/layout_guard.py\" --hook 2>/dev/null || true",
            "timeout": 20
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true
  }
}
