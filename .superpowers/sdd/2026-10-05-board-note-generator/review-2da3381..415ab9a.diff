+    return (f"Crude Steel production during {{P}} was {bnc.fmt_t(cs)} T ({bnc.fmt_pct(cs_pct)}% of ABP) and Saleable "
+            f"Steel production was {bnc.fmt_t(ss)} T ({bnc.fmt_pct(ss_pct)}% of ABP).")
+
